---
// Витрина «хамелеон»: первый экран сайта и десять вариантов переливающейся
// кнопки «Подобрать автомобиль». Страница показная, не часть сайта.
import '../styles/theme-v1.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hero } from '../content/home';

const variants = [
  { id: 'malachite', name: 'Малахит', note: 'глубокий камень с прожилками' },
  { id: 'chrome-mint', name: 'Хром и мята', note: 'палитра Community Dealer' },
  { id: 'jade', name: 'Нефрит', note: 'матовый камень с тёплым светом' },
  { id: 'liquid', name: 'Жидкий металл', note: 'ртуть с зелёным отливом' },
  { id: 'emerald', name: 'Изумруд', note: 'холодная глубина и блик' },
  { id: 'olive-gold', name: 'Олива и золото', note: 'приглушённый люкс' },
  { id: 'aurora', name: 'Северное сияние', note: 'медленная зелёная волна' },
  { id: 'pearl', name: 'Перламутр', note: 'настоящая краска-хамелеон' },
  { id: 'copper', name: 'Медь и зелень', note: 'патина на металле' },
  { id: 'black-chrome', name: 'Чёрный хром', note: 'почти графит, зелёный кант' },
];
---

<BaseLayout theme="v1" title="Хамелеон: варианты кнопки | Evolution Car" description="Витрина вариантов переливающейся кнопки" noindex>
  <div class="demo" data-variant="malachite">
    <header class="bar">
      <span class="bar__logo">EVOLUTION CAR</span>
      <a class="cta cta--sm" href="#bottom">{hero.cta}</a>
    </header>

    <section class="screen">
      <img class="screen__bg" src="/img/hero-evolution-hd-v2.webp" alt="" width="1448" height="1086" />
      <div class="screen__inner">
        <h1 class="screen__title">{hero.title}</h1>
        <p class="screen__lead">{hero.lead}</p>
        <a class="cta" href="#bottom" id="bottom">{hero.cta}</a>
      </div>
    </section>

    <section class="pick">
      <p class="pick__kicker">[ выберите цвет — он сразу встанет на экран ]</p>
      <h2 class="pick__title">Десять переливов</h2>
      <ul class="pick__list">
        {variants.map((v, i) => (
          <li>
            <button class="card" type="button" data-pick={v.id} aria-pressed={i === 0}>
              <span class={`cta cta--card v-${v.id}`}>{hero.cta}</span>
              <span class="card__name">{v.name}</span>
              <span class="card__note">{v.note}</span>
            </button>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style is:global>
  /* ——— каркас витрины ——— */
  .demo { --speed: 9s; background: #07090b; color: #eef1ef; min-height: 100vh; }
  .bar {
    position: sticky; top: 0; z-index: 10;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: .75rem clamp(1rem, 3vw, 2.5rem);
    background: rgba(7, 9, 11, .72); backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, .08);
  }
  .bar__logo { font-family: var(--font-display); font-size: .875rem; letter-spacing: .32em; }

  .screen { position: relative; min-height: 86vh; display: grid; align-items: end; overflow: hidden; }
  .screen__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .screen::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(7,9,11,.65) 0%, rgba(7,9,11,0) 40%),
                linear-gradient(0deg, #07090b 3%, rgba(7,9,11,.15) 60%);
  }
  .screen__inner { position: relative; z-index: 1; display: grid; gap: 1rem; justify-items: start;
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1rem, 3vw, 2.5rem); max-width: 60rem; }
  .screen__title { font-family: var(--font-display); font-size: clamp(1.8rem, 1.1rem + 3.4vw, 4rem); line-height: 1.04; margin: 0; }
  .screen__lead { color: #b9c2bd; font-size: 1.0625rem; margin: 0; }

  .pick { padding: clamp(2rem, 4vw, 4rem) clamp(1rem, 3vw, 2.5rem) 5rem; }
  .pick__kicker { color: #6f7a75; font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 .5rem; }
  .pick__title { font-family: var(--font-display); font-size: clamp(1.3rem, 1rem + 1.4vw, 2rem); margin: 0 0 1.5rem; }
  .pick__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 780px) { .pick__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; } }
  @media (min-width: 1180px) { .pick__list { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .card {
    width: 100%; display: grid; gap: .5rem; justify-items: center; text-align: center;
    padding: 1rem .75rem 1.1rem; background: #10130f; border: 1px solid rgba(255,255,255,.08);
    border-radius: 14px; cursor: pointer; transition: border-color .25s, transform .25s;
  }
  .card:hover { transform: translateY(-2px); border-color: rgba(255,255,255,.2); }
  .card[aria-pressed="true"] { border-color: #8fc7ad; }
  .card__name { font-size: .9375rem; color: #eef1ef; }
  .card__note { font-size: .75rem; color: #7d8783; line-height: 1.4; }

  /* ——— сама кнопка ——— */
  .cta {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    padding: 1.05rem 2.2rem; min-width: min(100%, 19rem);
    border-radius: 14px; font-family: var(--font-body); font-weight: 600;
    font-size: 1rem; letter-spacing: .01em; text-decoration: none; overflow: hidden;
    color: #07110c; isolation: isolate; border: 1px solid transparent;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.28), inset 0 -1px 0 rgba(0,0,0,.35), 0 10px 30px -14px rgba(0,0,0,.9);
  }
  .cta--sm { padding: .6rem 1.2rem; min-width: 0; font-size: .8125rem; border-radius: 10px; }
  .cta--card { padding: .8rem 1rem; min-width: 0; width: 100%; font-size: .8125rem; border-radius: 10px; }
  /* блик, общий для всех вариантов: медленно скользит по кнопке */
  .cta::after {
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: linear-gradient(105deg, transparent 38%, rgba(255,255,255,.42) 48%, transparent 58%);
    background-size: 280% 100%; animation: sheen var(--speed) linear infinite;
    mix-blend-mode: screen; opacity: .75;
  }
  @keyframes sheen { from { background-position: 180% 0; } to { background-position: -80% 0; } }
  @keyframes flow { from { background-position: 0% 50%; } to { background-position: 200% 50%; } }
  @keyframes turn { to { transform: rotate(1turn); } }

  /* ——— десять переливов ——— */
  .v-malachite, .demo[data-variant="malachite"] .cta:not(.cta--card) {
    background: linear-gradient(100deg, #0b2a20 0%, #17483a 22%, #2f8f6b 42%, #7fe0b0 52%, #2f8f6b 62%, #123c2f 82%, #0b2a20 100%);
    background-size: 220% 100%; animation: flow calc(var(--speed) * 1.4) linear infinite; color: #eafff5;
  }
  .v-chrome-mint, .demo[data-variant="chrome-mint"] .cta:not(.cta--card) {
    background: linear-gradient(100deg, #cfd6d2 0%, #ffffff 16%, #8fc7ad 38%, #e7efe9 52%, #8fc7ad 66%, #ffffff 84%, #cfd6d2 100%);
    background-size: 220% 100%; animation: flow var(--speed) linear infinite; color: #0c1a14;
  }
  .v-jade, .demo[data-variant="jade"] .cta:not(.cta--card) {
    background: linear-gradient(100deg, #10352b 0%, #1d5a47 28%, #46a583 48%, #9ad9bd 56%, #46a583 66%, #1d5a47 84%, #10352b 100%);
    background-size: 220% 100%; animation: flow calc(var(--speed) * 1.25) linear infinite; color: #effff8;
  }
  .v-liquid, .demo[data-variant="liquid"] .cta:not(.cta--card) {
    background: linear-gradient(100deg, #8d9a96 0%, #f2f6f4 12%, #5d7a71 30%, #d8e6e0 46%, #38d9a0 56%, #d8e6e0 66%, #5d7a71 84%, #8d9a96 100%);
    background-size: 240% 100%; animation: flow calc(var(--speed) * .85) linear infinite; color: #0b1512;
  }
  .v-emerald, .demo[data-variant="emerald"] .cta:not(.cta--card) {
    background: linear-gradient(100deg, #042c22 0%, #06493a 24%, #0a7d60 44%, #19c48f 54%, #0a7d60 64%, #06493a 84%, #042c22 100%);
    background-size: 220% 100%; animation: flow calc(var(--speed) * 1.3) linear infinite; color: #e6fff6;
  }
  .v-olive-gold, .demo[data-variant="olive-gold"] .cta:not(.cta--card) {
    background: linear-gradient(100deg, #26301a 0%, #3c4a24 22%, #6f7d3a 40%, #cdbb6a 52%, #6f7d3a 64%, #3c4a24 84%, #26301a 100%);
    background-size: 220% 100%; animation: flow calc(var(--speed) * 1.35) linear infinite; color: #fcf8e6;
  }
  .v-aurora, .demo[data-variant="aurora"] .cta:not(.cta--card) {
    background: linear-gradient(100deg, #06221f 0%, #0b4a45 20%, #1f8f76 38%, #74e0a8 50%, #2bb6c9 62%, #0b4a45 82%, #06221f 100%);
    background-size: 240% 100%; animation: flow calc(var(--speed) * 1.5) linear infinite; color: #eafff9;
  }
  .v-pearl, .demo[data-variant="pearl"] .cta:not(.cta--card) {
    background: linear-gradient(100deg, #1a3b32 0%, #2f7d63 18%, #76d7ae 34%, #b9cfe6 46%, #8f7fd4 58%, #2f7d63 80%, #1a3b32 100%);
    background-size: 250% 100%; animation: flow calc(var(--speed) * 1.1) linear infinite; color: #f2fff9;
  }
  .v-copper, .demo[data-variant="copper"] .cta:not(.cta--card) {
    background: linear-gradient(100deg, #1d3b31 0%, #2f6b53 20%, #7bbd99 36%, #d49a6a 50%, #7bbd99 64%, #2f6b53 82%, #1d3b31 100%);
    background-size: 230% 100%; animation: flow calc(var(--speed) * 1.2) linear infinite; color: #fff6ec;
  }
  .v-black-chrome, .demo[data-variant="black-chrome"] .cta:not(.cta--card) {
    background: linear-gradient(100deg, #0c100e 0%, #20282a 18%, #38484a 34%, #7fd6b2 48%, #38484a 62%, #20282a 82%, #0c100e 100%);
    background-size: 240% 100%; animation: flow var(--speed) linear infinite;
    color: #e8fff5; border-color: rgba(127, 214, 178, .35);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta, .cta::after { animation: none !important; }
  }
</style>

<script>
  const demo = document.querySelector('.demo');
  for (const b of document.querySelectorAll('[data-pick]')) {
    b.addEventListener('click', () => {
      demo?.setAttribute('data-variant', b.getAttribute('data-pick'));
      for (const o of document.querySelectorAll('[data-pick]')) o.setAttribute('aria-pressed', String(o === b));
      document.querySelector('.screen')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>
