---
import '../../../styles/theme-v1.css';
import '../../../styles/islands.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/v1/Header.astro';
import Footer from '../../../components/v1/Footer.astro';
import Breadcrumbs from '../../../components/v1/Breadcrumbs.astro';
import CarCard from '../../../components/v1/CarCard.astro';
import ModalHost from '../../../components/islands/ModalHost';
import LeadForm from '../../../components/islands/LeadForm';
import {
  cars, countries, powertrains, availabilities, formatUsd, specGroups,
  slugify, modelSlug, carPath, brandPath, noteRows,
} from '../../../content/cars';
import type { Car } from '../../../content/cars';
import { carMeta, carKeywords, carLd, breadcrumbsLd } from '../../../lib/seo';

import { quiz, finalOffer, benefits, steps } from '../../../content/home';

export function getStaticPaths() {
  return cars.map((car) => ({
    params: { brand: slugify(car.brand), model: modelSlug(car) },
    props: { car },
  }));
}

const { car } = Astro.props as { car: Car };
const meta = carMeta(car);
const groups = specGroups(car);

// Модели, у которых есть конфигуратор, – кнопка рядом с «Характеристиками»
const CONFIGURATORS: Record<string, string> = {
  'lixiang-l9': '/catalog/lixiang/l9/konfigurator/',
  'lixiang-l6': '/catalog/lixiang/l6/konfigurator/',
  'lixiang-l8': '/catalog/lixiang/l8/konfigurator/',
  'xiaomi-su7': '/catalog/xiaomi/su7/konfigurator/',
  'xiaomi-yu7': '/catalog/xiaomi/yu7/konfigurator/',
  'avatr-12': '/catalog/avatr/12/konfigurator/',
  'voyah-dreamer': '/catalog/voyah/dreamer/konfigurator/',
};
const configurator = CONFIGURATORS[car.slug];

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Каталог автомобилей', href: '/catalog/' },
  { name: car.brand, href: brandPath(car.brand) },
  { name: car.title, href: carPath(car) },
];

const facts = [
  ...(car.priceUsd ? [{ label: 'Ориентир под ключ', value: `от ${formatUsd(car.priceUsd)}`, accent: true }] : []),
  ...(car.priceByn ? [{ label: 'В белорусских рублях', value: `≈ ${car.priceByn.toLocaleString('ru-RU')} BYN` }] : []),
  { label: 'Наличие', value: availabilities[car.availability] },
  { label: 'Рынок', value: countries[car.country].label },
  { label: 'Двигатель', value: powertrains[car.powertrain] },
  ...(car.year ? [{ label: 'Год выпуска', value: car.year }] : []),
];

const similar = cars
  .filter((c) => c.slug !== car.slug && c.brand === car.brand)
  .concat(cars.filter((c) => c.slug !== car.slug && c.country === car.country && c.powertrain === car.powertrain))
  .filter((c, i, arr) => arr.findIndex((x) => x.slug === c.slug) === i)
  .slice(0, 3);
import CompareButtons from '../../../components/v1/CompareButtons.astro';
import { COMPARE_SLUGS } from '../../../content/compare';
import CarGallery from '../../../components/v1/CarGallery.astro';
import { galleryFor } from '../../../content/galleries';
const alt = `${car.title} – ${powertrains[car.powertrain].toLowerCase()}, поставка ${countries[car.country].genitive}`;
// галерея – только у машин, для которых есть набор фото (пока Zeekr 7X)
const extra = galleryFor(car.slug, car.title);
// галерея с закрытым кадром – только у машин с официальными фото (galleries.json);
// раскатка на весь каталог остановлена владельцем 13.10.2026, см. AGENTS.md
const gallery = extra ? [{ src: car.photo, thumb: car.photo, alt }, ...extra] : null;
---

<BaseLayout
  theme="v1"
  title={meta.title}
  description={meta.description}
  keywords={carKeywords(car)}
  canonical={meta.canonical}
  ogImage={car.photo}
  jsonLd={[breadcrumbsLd(crumbs), carLd(car)]}
>
  <Header />
  <Breadcrumbs crumbs={crumbs} />

  <main>
    <article>
      <section class="section section--top">
        <div class:list={['container top', { 'top--gallery': gallery }]}>
          {gallery ? (
            <div class="top__gallery"><CarGallery shots={gallery} /></div>
          ) : (
            <div class="gallery">
              <img class="gallery__main" src={car.photo} alt={alt} width="900" height="563" fetchpriority="high" />
              <p class="gallery__note">
                Фотография модели. Снимки конкретного автомобиля с площадки менеджер
                пришлёт до согласования договора.
              </p>
            </div>
          )}

          <div class="intro">
            <p class="kicker">[ {countries[car.country].label} · {availabilities[car.availability]} ]</p>
            <h1 class="intro__title">{car.title}</h1>
            <p class="intro__tagline">{car.description}</p>

            <dl class="facts">
              {facts.map((fact) => (
                <div class={fact.accent ? 'fact fact--accent' : 'fact'}>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>

            <div class="intro__actions">
              <a class="btn" href="#request" data-open="lead">Заказать</a>
              <a class="btn btn--ghost" href="#specs">Характеристики</a>
              {configurator && <a class="btn btn--ghost" href={configurator}>Конфигуратор</a>}
            </div>
            {COMPARE_SLUGS.includes(car.slug) && <CompareButtons car={car} />}
          </div>

          <div class="intro-extra">
            {gallery && (
              <p class="gallery__note">
                Фото – официальные изображения производителя. Снимки конкретного автомобиля
                с площадки менеджер пришлёт до согласования договора.
              </p>
            )}

            <p class="intro__links">
              <a href={brandPath(car.brand)}>Все автомобили {car.brand}</a>
              <span aria-hidden="true">·</span>
              <a href={`/catalog/${countries[car.country].slug}/`}>Автомобили {countries[car.country].genitive}</a>
            </p>

            {car.note && (
              <dl class="intro__note">
                {noteRows(car.note).map((row) => (
                  <div>
                    {row.label && <dt>{row.label}</dt>}
                    <dd>
                      {row.value.startsWith('http')
                        ? <a href={row.value} target="_blank" rel="nofollow noopener">av.by</a>
                        : row.value}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </div>
      </section>

      {groups.length > 0 && (
        <section class="section section--tight" id="specs">
          <div class="container">
            <h2 class="block__title">Характеристики</h2>
            <div class="specs">
              {groups.map((group) => (
                <div class="card specs__group">
                  <h3 class="specs__title">{group.group}</h3>
                  <dl>
                    {group.rows.map((row) => (
                      <div class="specs__row">
                        <dt>{row.label}</dt>
                        <dd>
                          {row.value.startsWith('http') ? (
                            <a href={row.value} target="_blank" rel="nofollow noopener">Открыть источник</a>
                          ) : (
                            row.value
                          )}
                        </dd>
                      </div>
                    ))}
                  </dl>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="section section--tight">
        <div class="container">
          <h2 class="block__title">Что входит в стоимость под ключ</h2>
          <p class="included__lead">
            Подробно о сроках, маршрутах и составе платежей – на странице
            <a href="/dostavka-i-rastamozhka/">доставки и растаможки</a>.
          </p>
          <ul class="included">
            {benefits.map((item) => (
              <li class="card included__item">
                <span class="included__dot" aria-hidden="true"></span>
                <h3 class="included__title">{item.title}</h3>
                <p class="included__text">{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--tight">
        <div class="container">
          <h2 class="block__title">Как проходит покупка</h2>
          <ol class="flow">
            {steps.items.map((step, i) => (
              <li class="flow__step">
                <p class="flow__num">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="flow__title">{step.title}</h3>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section" id="request">
        <div class="container">
          <div class="card request">
            <div>
              <h2 class="request__title">Запросить расчёт по {car.title}</h2>
              <p class="request__text">
                Менеджер уточнит комплектацию, год и состояние, проверит доступные лоты
                на площадках {countries[car.country].genitive} и пришлёт стоимость под ключ
                с учётом доставки, таможенного оформления и подготовки документов.
              </p>
            </div>
            <LeadForm
              client:visible
              namePlaceholder={finalOffer.namePlaceholder}
              phonePlaceholder={finalOffer.phonePlaceholder}
              cta={finalOffer.cta}
              consent={finalOffer.consent}
              success={finalOffer.success}
              source={`Карточка: ${car.title}`}
              car={car.title}
              brand={car.brand}
            />
          </div>
        </div>
      </section>

      {similar.length > 0 && (
        <section class="section section--tight">
          <div class="container">
            <h2 class="block__title">Похожие автомобили</h2>
            <ul class="product-grid">
              {similar.map((item) => <li><CarCard car={item} /></li>)}
            </ul>
          </div>
        </section>
      )}

      <div class="container">
        <p class="disclaimer">
          Цена указана ориентировочно под ключ и не является публичной офертой. Итоговая
          стоимость зависит от курса валют, комплектации, состояния автомобиля, ставки
          на аукционе, маршрута доставки и обязательных платежей на дату сделки.
        </p>
      </div>
    </article>
  </main>

  <Footer />
  <ModalHost
    client:idle
    quizTitle={quiz.title}
    quizSteps={quiz.steps}
    contactQuestion={quiz.contactStep.q}
    channels={quiz.contactStep.channels}
    consent={finalOffer.consent}
    success={finalOffer.success}
    videoPoster="/img/unsplash/service.jpg"
  />
</BaseLayout>

<style>
  .section--top { padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .section--tight { padding-block: clamp(2rem, 1.2rem + 3vw, 3rem); }
  .block__title { margin-bottom: clamp(1.25rem, 1rem + 1vw, 2rem); }

  .top { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 3rem); }
  .intro-extra > :first-child { margin-top: 0; }
  @media (min-width: 1024px) {
    /* фото слева на обе строки, справа – описание с кнопками и под ним ссылки */
    .top {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-areas: 'g i' 'g x';
      align-items: start;
      row-gap: 0;
    }
    .gallery, .top__gallery { grid-area: g; }
    .intro { grid-area: i; }
    .intro-extra { grid-area: x; margin-top: 1.25rem; }
    /* с галереей: фото и миниатюры ровно по высоте блока до низа кнопок,
       подпись к фото и ссылки – под кнопками */
    .top--gallery { grid-template-areas: 'g i' '. x'; }
    .top--gallery .top__gallery { align-self: stretch; }
  }
  .top--gallery .gallery__note { margin-top: 0; margin-bottom: .75rem; }

  .gallery__main {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--r-card);
    background: var(--c-bg-alt);
  }
  .gallery__note { color: var(--c-text-3); font-size: .75rem; margin-top: .875rem; line-height: 1.5; }

  .intro__title { margin-top: .875rem; }
  .intro__tagline { color: var(--c-text-2); margin-top: 1rem; font-size: 1rem; line-height: 1.55; }
  .intro__links {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: .625rem;
    font-size: .875rem;
    color: var(--c-text-3);
  }
  .intro__links a { color: var(--c-accent); }
  .intro__links a:hover { color: var(--c-accent-hover); }

  .intro__note > div { display: flex; gap: .5rem; flex-wrap: wrap; padding-block: .25rem; }
  .intro__note dt { color: var(--c-text-3); }
  .intro__note dt::after { content: ':'; }
  .intro__note dd { margin: 0; }
  .intro__note dd a { color: var(--c-accent); }
  .intro__note {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line);
    color: var(--c-text-3);
    font-size: .8125rem;
    line-height: 1.5;
  }

  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); margin-top: 1.75rem; }
  .fact {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: 12px;
    padding: 1rem 1.125rem;
  }
  .fact dt { color: var(--c-text-3); font-size: .75rem; }
  .fact dd { margin-top: .375rem; font-size: .9375rem; }
  .fact--accent dd {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--c-accent);
  }

  .intro__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }

  .specs { display: grid; gap: var(--gap); }
  @media (min-width: 768px) { .specs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .specs__group { padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); align-content: start; }
  .specs__title { font-size: 1rem; margin-bottom: 1rem; }
  .specs__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: .625rem;
    border-bottom: 1px solid var(--c-line);
    font-size: .875rem;
  }
  .specs__row:last-child { border-bottom: 0; }
  .specs__row dt { color: var(--c-text-3); flex: none; max-width: 48%; }
  .specs__row dd { text-align: right; }
  .specs__row dd a { color: var(--c-accent); }

  .included__lead { color: var(--c-text-3); font-size: .9375rem; margin-bottom: 1.5rem; max-width: 70ch; }
  .included__lead a { color: var(--c-accent); }
  .included { display: grid; gap: var(--gap); }
  @media (min-width: 640px) { .included { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .included { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .included__item { padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); align-content: start; }
  .included__dot { display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--c-accent); margin-bottom: 1.5rem; }
  .included__title {
    font-family: var(--font-body);
    font-weight: 400;
    text-transform: none;
    font-size: 1.125rem;
    margin-bottom: .5rem;
  }
  .included__text { color: var(--c-text-3); font-size: .875rem; line-height: 1.5; }

  .flow { display: grid; gap: var(--gap); }
  @media (min-width: 640px) { .flow { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .flow__step { padding-top: 1rem; border-top: 2px solid var(--c-accent); }
  .flow__num { font-family: var(--font-display); font-weight: 700; color: var(--c-accent); font-size: 1.125rem; }
  .flow__title { font-family: var(--font-body); font-weight: 400; text-transform: none; font-size: .9375rem; margin-top: .375rem; line-height: 1.35; }

  .request {
    padding: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    background: var(--c-bg-alt);
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 1024px) { .request { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); gap: 3.5rem; } }
  .request__title { font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem); }
  .request__text { color: var(--c-text-3); font-size: .9375rem; margin-top: 1rem; max-width: 56ch; }


  .disclaimer {
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
    color: var(--c-text-3);
    font-size: .75rem;
    line-height: 1.5;
    max-width: 92ch;
  }
</style>
