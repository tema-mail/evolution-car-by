---
import '../styles/theme-v1.css';
import '../styles/islands.css';
import B2bPage, { type B2bContent } from '../components/v1/B2bPage.astro';

// Перенесено с evolutioncar.by/malanka: тексты вычитаны, смысл прежний.
const page: B2bContent = {
  path: '/dlya-biznesa/',
  seoTitle: 'Автомобили для бизнеса и автопарков в Беларуси – Evolution Car',
  seoDescription:
    'Подбираем автомобили для компаний: грузовые, пассажирские и для доставки по городу. Сравним варианты под ваши маршруты и рассчитаем стоимость с доставкой и оформлением в Беларуси.',
  kicker: 'Для бизнеса',
  h1: 'Автомобили для задач бизнеса',
  lead:
    'Грузоперевозки, пассажирские перевозки, доставка по городу. Подберём автомобиль под ваши маршруты, нагрузку и режим работы и рассчитаем полную стоимость с доставкой и оформлением в Беларуси.',
  cta: 'Обсудить задачу',
  image: '/img/Rectangle_30756.webp',
  steps: {
    title: 'От одной машины до автопарка',
    items: [
      { num: '01', title: 'Грузоперевозки', text: 'Подберём тип кузова и грузоподъёмность под ваши рейсы и характер груза.' },
      { num: '02', title: 'Пассажирские перевозки', text: 'Учтём вместимость, комфорт салона и режим работы: такси, трансфер или служебные поездки.' },
      { num: '03', title: 'Доставка по городу', text: 'Важны полезный объём, расход и удобство на коротких маршрутах с частыми остановками.' },
    ],
  },
  focus: {
    title: 'Начинаем с вашей задачи, а не с каталога',
    text:
      'Уточним маршруты, тип груза или пассажиропоток и нужное количество машин. Сравним подходящие варианты и покажем, из чего складывается итоговая стоимость. Конкретные модели и их характеристики подбираем под задачу.',
    points: ['Маршруты и пробег', 'Нагрузка и вместимость', 'Режим работы', 'Итоговая стоимость с доставкой и оформлением'],
    link: { label: 'Автомобили для таксопарков', href: '/dlya-taksoparkov/' },
  },
  final: {
    title: 'Расскажите о задаче',
    text: 'Оставьте контакты – менеджер уточнит маршруты и количество машин и подготовит варианты с расчётом стоимости.',
    source: 'Для бизнеса',
  },
};
---

<B2bPage page={page} />
