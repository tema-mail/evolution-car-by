---
import '../styles/theme-v1.css';
import '../styles/islands.css';
import B2bPage, { type B2bContent } from '../components/v1/B2bPage.astro';
import { site } from '../content/site';

// Перенесено с evolutioncar.by/invite2: тексты вычитаны, схема
// «поставщик → Evolution Car → клиент» сохранена.
const page: B2bContent = {
  path: '/partneram/',
  seoTitle: 'Партнёрам и поставщикам автомобилей – Evolution Car',
  seoDescription:
    'Предложите Evolution Car поставки автомобилей для клиентов в Беларуси: расскажите об ассортименте, рынках и условиях работы.',
  kicker: 'Партнёрам',
  h1: 'Поставляете автомобили? Давайте работать вместе',
  lead:
    'Расскажите об ассортименте и условиях работы. Обсудим, как ваши предложения могут подойти клиентам Evolution Car в Беларуси.',
  cta: 'Предложить сотрудничество',
  image: '/img/Rectangle_30755.webp',
  chain: [
    { title: 'Поставщик', note: 'Ассортимент и условия' },
    { title: 'Evolution Car', note: 'Проверка и расчёт' },
    { title: 'Клиент', note: 'Выбор автомобиля' },
  ],
  steps: {
    title: 'Как строим работу',
    items: [
      { num: '01', title: 'Получаем предложение', text: 'Ассортимент, контакты, условия поставки и документы.' },
      { num: '02', title: 'Проверяем условия', text: 'Уточняем данные конкретного автомобиля и возможность доставки.' },
      { num: '03', title: 'Предлагаем клиенту', text: 'Считаем полную стоимость и показываем клиенту подходящие варианты.' },
    ],
  },
  focus: {
    title: 'Нам нужны конкретные условия',
    text: 'Сообщите, с какими рынками и моделями вы работаете, как подтверждаете состояние автомобиля и какие документы предоставляете.',
    points: ['Рынки и модели', 'Подтверждение состояния автомобиля', 'Документы на автомобиль', 'Условия и сроки поставки'],
  },
  final: {
    title: 'Обсудим сотрудничество',
    text: `Оставьте контакты или позвоните: ${site.phone}. Менеджер свяжется с вами и обсудит детали.`,
    source: 'Партнёрам',
  },
};
---

<B2bPage page={page} />
