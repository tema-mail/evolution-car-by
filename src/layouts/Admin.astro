---
/** Каркас кабинета Evolution Car – перенос кабинета-стандарта (Milovini → gaz-mag).
    Вкладки и шапка как у Elite Rose / ALEX KROWN v1, адрес сайта справа, «Выйти».
    Весь кабинет закрыт логином и паролем (scripts/lock-admin.mjs при выкладке),
    от поиска закрыт noindex и robots.txt.
    Тип проекта – каталог без корзины: «Продаж» нет, заказ = заявка с моделью и маркой. */
import '../styles/admin.css';
import { cars } from '../content/cars';
import { site as siteInfo } from '../content/site';

type Tab =
  | 'pages'
  | 'products'
  | 'leads'
  | 'metrika'
  | 'seo'
  | 'positions'
  | 'recommendations';

interface Props {
  title: string;
  active: Tab;
}
const { title, active } = Astro.props;
const site = new URL('/', Astro.site).href;

// Кабинет живёт в корне поддомена admin.evolutioncar.by, а файлы собираются
// в /admin/ – префикс подставляет Caddy. Поэтому ссылки здесь без /admin:
// со старого адреса /admin/… nginx переадресует на поддомен с тем же путём.
const tabs: [Tab, string, string, string][] = [
  ['pages', '/', 'Страницы сайта', ''],
  ['products', '/products/', 'Автомобили', String(cars.length)],
  ['leads', '/leads/', 'Заявки', ''],
  ['metrika', '/metrika/', 'Метрика', ''],
  ['seo', '/seo/', 'SEO-аналитика', ''],
  ['positions', '/positions/', 'Позиции', ''],
  ['recommendations', '/recommendations/', 'Рекомендации', '🔒'],
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} – кабинет {siteInfo.brand}</title>
    <link rel="icon" href="/favicon-32.png" type="image/png" />
  </head>
  <body class="adm">
    <nav class="topnav" aria-label="Разделы кабинета">
      <span class="brand">EVOLUTION CAR</span>
      {
        tabs.map(([key, href, label, n]) => (
          <a class:list={['tab', { on: active === key }]} href={href}>
            {label}
            {n && (n === '🔒'
              ? <span class="lk" aria-label="раздел закрыт"> 🔒</span>
              : <span class="n">{n}</span>)}
          </a>
        ))
      }
      <span class="site">🟢 Боевой сайт · Сайт: <a href={site} target="_blank" rel="noopener">{site.replace(/^https?:\/\//, '')}</a></span>
      <button
        type="button"
        class="logout"
        onclick="try{sessionStorage.removeItem('ec_admin_auth');localStorage.removeItem('ec_admin_keep')}catch(e){};location.reload()"
        style="background:none;border:0;color:rgba(255,255,255,.75);font:inherit;font-size:13px;cursor:pointer;padding:0"
        >Выйти</button
      >
    </nav>
    <main><slot /></main>
  </body>
</html>
