---
import '../styles/base.css';
import { analytics, site } from '../content/site';
import Intro from '../components/v1/Intro.astro';
import { productByPath, pageProductJson } from '../lib/product';

interface Props {
  theme: 'v1' | 'v2';
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  /** пока сайт не запущен, страницы закрыты от индексации */
  noindex?: boolean;
  /** блоки schema.org; по умолчанию – карточка организации */
  jsonLd?: unknown[];
}

const {
  theme,
  title,
  description,
  canonical,
  ogImage = '/img/hero-evolution-hd-v2.jpg',
  noindex = true,
  jsonLd,
} = Astro.props;

const fonts =
  theme === 'v1'
    ? 'family=Inter:wght@500..700&family=Golos+Text:wght@400;500;600'
    : 'family=Manrope:wght@300;400;500;600&family=Golos+Text:wght@400;500;600';

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  name: site.brand,
  legalName: site.company,
  taxID: site.unp,
  telephone: site.phone,
  email: site.email,
  url: Astro.site?.href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressCountry: 'BY',
    streetAddress: site.showroom,
  },
  openingHours: 'Mo-Su 09:00-18:00',
};

const blocks = jsonLd ?? [organizationLd];

// Карточка товара определяется по адресу страницы – сами страницы карточек
// не правятся. Данные товара встраиваются в HTML для событий Google (analytics.ts).
const product = productByPath(Astro.url.pathname);
const productJson = product ? pageProductJson(product) : null;

// Google Tag Manager подключается только с ID контейнера при сборке. Без него
// на сайте нет тегов аналитики и рекламы Google – события лежат в dataLayer
// (шрифты Google грузятся как и раньше). Пробелы и регистр в ID из секретов
// workflow прощаются; всё, что не похоже на GTM-XXXX, отбрасывается.
// Значение берётся из site.ts, а переменная окружения с тем же именем его
// перекрывает: так тестовый стенд собирается без счётчиков, а прод – с ними.
// Обращение к import.meta.env только по явному имени: Vite подставляет их
// при сборке, динамический ключ вернёт undefined.
const pick = (fromEnv: unknown, fallback: string) => {
  const value = String(fromEnv ?? '').trim();
  return value !== '' ? value : fallback;
};

const gtmRaw = pick(import.meta.env.PUBLIC_GTM_ID, analytics.gtm).toUpperCase();
const gtmId = /^GTM-[A-Z0-9]+$/.test(gtmRaw) ? gtmRaw : null;

const ymRaw = pick(import.meta.env.PUBLIC_YM_ID, analytics.yandexMetrika);
const ymId = /^[0-9]{5,10}$/.test(ymRaw) ? ymRaw : null;

const gaRaw = pick(import.meta.env.PUBLIC_GA_ID, analytics.ga4).toUpperCase();
const gaId = /^G-[A-Z0-9]+$/.test(gaRaw) ? gaRaw : null;

// Виджет Битрикс24 с формой заявки и обратным звонком – тот же, что стоял
// на Тильде. Принимаем только адрес на домене bitrix24, чтобы опечатка
// в настройке не превратилась в загрузку чужого скрипта.
const b24Raw = pick(import.meta.env.PUBLIC_B24_WIDGET, analytics.bitrix24Widget);
const b24Url = /^https:\/\/[a-z0-9.-]+\.bitrix24\.[a-z]{2,3}\/[A-Za-z0-9_/.-]+\.js$/.test(b24Raw)
  ? b24Raw
  : null;
---

<!doctype html>
<html lang="ru" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      gtmId && (
        <script is:inline define:vars={{ gtmId }}>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s);
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtmId);
        </script>
      )
    }
    {
      gaId && (
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
      )
    }
    {
      gaId && (
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      )
    }
    {
      ymId && (
        <script is:inline define:vars={{ ymId }}>
          (function (m, e, t, r, i, k, a) {
            m[i] =
              m[i] ||
              function () {
                (m[i].a = m[i].a || []).push(arguments);
              };
            m[i].l = 1 * new Date();
            for (var j = 0; j < document.scripts.length; j++) {
              if (document.scripts[j].src === r) return;
            }
            (k = e.createElement(t)), (a = e.getElementsByTagName(t)[0]), (k.async = 1), (k.src = r);
            a.parentNode.insertBefore(k, a);
          })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
          window.ym(Number(ymId), 'init', {
            ssr: true,
            webvisor: true,
            clickmap: true,
            trackLinks: true,
            accurateTrackBounce: true,
          });
        </script>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />

    {blocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    {productJson && <script type="application/json" id="product-item" set:html={productJson} />}
  </head>
  <body>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    {theme === 'v1' && <Intro />}
    <slot />
    {
      ymId && (
        <noscript>
          <div>
            <img
              src={`https://mc.yandex.ru/watch/${ymId}`}
              style="position:absolute; left:-9999px"
              alt=""
            />
          </div>
        </noscript>
      )
    }
    {
      b24Url && (
        <script is:inline define:vars={{ b24Url }}>
          (function (w, d, u) {
            var s = d.createElement('script');
            s.async = true;
            s.src = u + '?' + ((Date.now() / 60000) | 0);
            var h = d.getElementsByTagName('script')[0];
            h.parentNode.insertBefore(s, h);
          })(window, document, b24Url);
        </script>
      )
    }
    <script>
      import { initAnalytics } from '../lib/analytics';
      initAnalytics();
    </script>
  </body>
</html>
