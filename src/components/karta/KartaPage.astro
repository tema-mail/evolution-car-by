---
/**
 * Карточка модели «Китай под заказ» по образцу Zeekr 9X (Deford2027/evolution-service-minsk).
 * Разметка и данные – src/content/karty/<slug>.json, стили и скрипты – public/kartochki/.
 * Всё это собирает scripts/karty/build.py: правки блоков – в образце, потом пересборка.
 * Шаблон сайта даёт аналитику, согласие на cookie, мету и schema.org; шапка и подвал – общие с сайтом, блоки – карточки.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../v1/Header.astro';
import Footer from '../v1/Footer.astro';
import Breadcrumbs from '../v1/Breadcrumbs.astro';
import { cars, carPath, brandPath } from '../../content/cars';
import { breadcrumbsLd } from '../../lib/seo';
import '../../styles/theme-v1.css';

interface Karta {
  slug: string; url: string; title: string; description: string;
  ogImage: string | null; preload: string | null; css: string[]; jsonLd: unknown[]; html: string; brand: string;
}
const all = import.meta.glob<Karta>('../../content/karty/*.json', { eager: true, import: 'default' });
const { slug } = Astro.props as { slug: string };
const k = Object.values(all).find((x) => x.slug === slug);
if (!k) throw new Error(`Нет карточки ${slug}: пересоберите scripts/karty/build.py`);
// хлебные крошки – как на страницах моделей сайта ([model].astro)
const car = cars.find((c) => c.slug === slug);
if (!car) throw new Error(`Нет машины ${slug} в cars.json`);
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Каталог автомобилей', href: '/catalog/' },
  { name: car.brand, href: brandPath(car.brand) },
  { name: car.title, href: carPath(car) },
];
const jsonLd = [breadcrumbsLd(crumbs), ...(k.jsonLd as { '@type'?: string }[]).filter((g) => g['@type'] !== 'BreadcrumbList')];
---

<BaseLayout theme="v1" title={k.title} description={k.description} canonical={new URL(k.url, Astro.site).href} ogImage={k.ogImage ?? undefined} jsonLd={jsonLd}>
  <Fragment slot="head">
    {/* тема карточки – только тёмная, как сайт; переключатель скрыт (data-evk – data-theme занят темой сайта) */}
    <script is:inline>document.documentElement.setAttribute('data-evk','dark');</script>
    {k.preload && <link rel="preload" as="image" href={k.preload} />}
  </Fragment>
  {/* стили карточки – после стилей сайта (Astro кладёт их в конец <head>), чтобы вид блоков был как в образце */}
  {k.css.map((href) => <link rel="stylesheet" href={href} />)}
  <Header />
  <Breadcrumbs crumbs={crumbs} />
  <div class="evk" data-brand={k.brand} set:html={k.html} />
  <Footer />
</BaseLayout>

<script>
  // Формы карточки (расчёт, тест-драйв, лизинг, сборка из конфигуратора) -> приёмник заявок сайта
  import { submitLead } from '../../lib/submit';
  const w = window as unknown as {
    CAR?: { name?: string };
    evkLead?: (o: { name: string; phone: string; form: string; text: string }) => Promise<boolean>;
  };
  w.evkLead = (o) => {
    const car = w.CAR?.name || document.querySelector('h1')?.textContent?.trim() || '';
    const source = `Карточка ${car}: ${o.form}${o.text ? ' – ' + o.text : ''}`.slice(0, 300);
    const brand = (document.querySelector('.evk') as HTMLElement | null)?.dataset.brand || car.split(' ')[0];
    return submitLead({ name: o.name || '', phone: o.phone, source, consent: true, car, brand });
  };
</script>
