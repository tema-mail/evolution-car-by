---
import { directions } from '../../content/home';
import SlideArrows from '../shared/SlideArrows.astro';
---

<section class="section directions" id="directions" data-slider>
  <div class="container">
    <div class="sec-head">
      <p class="kicker">[ {directions.kicker} ]</p>
      <div class="sec-head__main">
        <h2>{directions.title}</h2>
        <div class="sec-head__aside">
          <p class="sec-head__lead">{directions.lead}</p>
          <SlideArrows always />
        </div>
      </div>
    </div>
  </div>

  <ul class="dir-track" role="list" data-track>
    {directions.items.map((item) => (
      <li class="dir-card">
        <div class="dir-card__copy">
          <h3 class="dir-card__title">{item.title}</h3>
          <p class="dir-card__text">{item.text}</p>
        </div>
        <div class="dir-card__shot">
          <img class="dir-card__img" src={item.img} alt="" loading="lazy" width="854" height="950" />
        </div>
        <a class="btn dir-card__cta" href={item.href}>{item.cta}</a>
      </li>
    ))}
  </ul>

  <div class="container">
    <div class="card dir-fallback">
      <div>
        <h3 class="dir-fallback__title">{directions.fallback.title}</h3>
        <p class="dir-fallback__text">{directions.fallback.text}</p>
      </div>
      <a class="btn dir-fallback__cta" href="/#final" data-open="lead">{directions.fallback.cta}</a>
    </div>
  </div>
</section>

<style>
  .sec-head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem); }
  .sec-head__lead {
    color: var(--c-text-3);
    max-width: 46ch;
    margin-top: 1.5rem;
    font-size: 1rem;
  }
  .sec-head__aside { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; }
  .sec-head__aside .sec-head__lead { margin-top: 0; }
  @media (min-width: 1024px) {
    .sec-head { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: 2rem; }
    .sec-head__main h2 { max-width: 56rem; }
  }

  .dir-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82vw, 27rem);
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--edge);
    /* без этого прилипание прижимало первую карточку к краю экрана */
    scroll-padding-inline: var(--edge);
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--c-line-strong) transparent;
  }
  /* Как у эталона на Tilda: крупный заголовок и текст, под ними картинка,
     кнопка – под картинкой и на неё не заходит. */
  .dir-card {
    scroll-snap-align: start;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border-radius: var(--r-card);
    background: var(--c-bg-alt);
    border: 1px solid var(--c-line);
    overflow: hidden;
  }
  .dir-card__copy { display: grid; gap: .75rem; align-content: start; padding: clamp(1.25rem, 1rem + 1.2vw, 1.75rem) clamp(1.25rem, 1rem + 1.2vw, 1.75rem) 1.25rem; }
  .dir-card__title { font-size: clamp(1.5rem, 1.2rem + 1.1vw, 1.875rem); line-height: 1.08; }
  .dir-card__text { color: var(--c-text-2); font-size: .9375rem; line-height: 1.45; }
  .dir-card__shot { align-self: end; position: relative; }
  /* фото плавно растворяется в фоне карточки сверху и снизу */
  .dir-card__shot::before,
  .dir-card__shot::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
  }
  .dir-card__shot::before { top: 0; height: 22%; background: linear-gradient(180deg, var(--c-bg-alt), transparent); }
  .dir-card__shot::after { bottom: 0; height: 45%; background: linear-gradient(0deg, var(--c-bg-alt) 0%, color-mix(in srgb, var(--c-bg-alt) 55%, transparent) 45%, transparent 100%); }
  /* исходники вертикальные: кадрируем по нижней части, где стоит автомобиль */
  .dir-card__img { display: block; width: 100%; aspect-ratio: 16 / 11; object-fit: cover; object-position: center 72%; }
  .dir-card__cta { margin: 1.25rem clamp(1.25rem, 1rem + 1.2vw, 1.75rem) clamp(1.25rem, 1rem + 1.2vw, 1.75rem); font-size: .75rem; }

  .dir-fallback {
    margin-top: clamp(2rem, 1rem + 3vw, 3.5rem);
    padding: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    display: grid;
    gap: 1.5rem;
    background: var(--c-bg-alt);
  }
  .dir-fallback__title { font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem); }
  .dir-fallback__text { color: var(--c-text-3); margin-top: 1rem; max-width: 70ch; font-size: 1rem; }
  .dir-fallback__cta { justify-self: start; }
  @media (min-width: 1024px) {
    .dir-fallback { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 3rem; }
    .dir-fallback__cta { justify-self: end; }
  }
</style>
