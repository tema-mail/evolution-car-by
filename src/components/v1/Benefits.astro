---
import { benefits } from '../../content/home';
---

<section class="section benefits">
  <div class="container">
    <ul class="grid grid--4 benefits__list">
      {benefits.map((item) => (
        <li class="card benefit">
          <span class="benefit__dot" aria-hidden="true"></span>
          {/* h2, а не h3: у секции своего заголовка нет, и h3 сразу после h1
              давал разрыв в структуре – проверка доступности снимала за это
              балл (найдено 07.11.2026). Размер задаёт класс, не тег. */}
          <h2 class="benefit__title">{item.title}</h2>
          <p class="benefit__text">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .benefits { padding-block: clamp(2rem, 1rem + 4vw, 4rem); }

  /* телефон: буллеты слайдером вправо – следующая карточка выглядывает с края */
  @media (max-width: 639px) {
    .benefits__list {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      gap: .75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
    .benefits__list::-webkit-scrollbar { display: none; }
    .benefits__list > li { scroll-snap-align: start; }
    .benefit__dot { margin-bottom: 1.25rem; }
  }

  .benefit {
    padding: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    display: grid;
    align-content: start;
    gap: .75rem;
  }
  .benefit__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent);
    margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
  }
  /* на тильде заголовки карточек набраны текстовым гротеском, не Oswald */
  .benefit__title {
    font-family: var(--font-body);
    font-weight: 400;
    text-transform: none;
    letter-spacing: -.01em;
    font-size: clamp(1.25rem, 1.1rem + .6vw, 1.5rem);
    line-height: 1.2;
  }
  .benefit__text {
    color: var(--c-text-3);
    font-size: 1rem;
    line-height: 1.45;
  }
</style>
