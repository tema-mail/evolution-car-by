---
import { steps, finalOffer } from '../../content/home';
import LeadForm from '../islands/LeadForm';
import SlideArrows from '../shared/SlideArrows.astro';
---

<section class="section steps" id="steps" data-slider>
  <div class="container">
    <div class="sec-head">
      <p class="kicker">[ {steps.kicker} ]</p>
      <div class="sec-head__main">
        <h2 class="steps__title">{steps.title}</h2>
        <div class="sec-head__aside"><SlideArrows always /></div>
      </div>
    </div>
  </div>

  <ul class="steps__track" role="list" data-track>
    {steps.items.map((step) => (
      <li class="card steps__card">
        <div class="steps__body">
          <p class="steps__num">{step.n}</p>
          <h3 class="steps__card-title">{step.title}</h3>
          {step.form ? (
            <p class="steps__text">{step.text}</p>
          ) : (
            step.text.split('\n').map((line) => <p class="steps__text">{line}</p>)
          )}
        </div>

        {step.form ? (
          <div class="steps__form">
              <LeadForm
                client:visible
                namePlaceholder="Имя"
                phonePlaceholder="Телефон"
                cta="Оставить заявку"
                consent="Согласен на обработку персональных данных"
                success={finalOffer.success}
              source="Пять шагов"
            />
          </div>
        ) : (
          <a class="btn btn--block steps__cta" href="/#final" data-open="lead">Оставить заявку</a>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .sec-head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 1rem + 3vw, 3rem); }
  @media (min-width: 1024px) {
    .sec-head { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: 2rem; align-items: start; }
  }
  .steps__title { max-width: 24ch; }
  /* стрелки ленты – по правому краю сетки */
  .sec-head__aside { display: flex; justify-content: flex-end; margin-top: 1.5rem; }

  .steps__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(84vw, 26.5rem);
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--edge);
    scroll-padding-inline: var(--edge);
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--c-line-strong) transparent;
    align-items: stretch;
  }
  .steps__card {
    scroll-snap-align: start;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    background: var(--c-surface);
  }
  /* на тильде «Шаг N» и заголовок набраны текстовым гротеском */
  .steps__num,
  .steps__card-title {
    font-family: var(--font-body);
    font-weight: 400;
    text-transform: none;
    letter-spacing: -.01em;
  }
  .steps__num { font-size: 1.375rem; margin-bottom: .75rem; }
  .steps__card-title { font-size: clamp(1.125rem, 1rem + .6vw, 1.4375rem); line-height: 1.25; }
  .steps__text { color: var(--c-text-3); font-size: .9375rem; line-height: 1.5; }
  .steps__body { display: grid; align-content: start; gap: .875rem; }
  .steps__form { align-self: end; }
  .steps__cta { align-self: end; }
</style>
