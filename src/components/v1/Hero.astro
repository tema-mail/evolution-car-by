---
import { hero } from '../../content/home';
---

<section class="hero">
  {/* Видео первого экрана – как на evolutioncar.by: на телефоне вертикальная
      версия 720×1280 (вырезана из 16:9 вокруг машины), на десктопе 16:9.
      Без звука и по кругу – иначе браузер не даст запустить его сам.
      Пока грузится, виден постер. */}
  {/* Адреса видео лежат в data-, а не в src: иначе браузер начинает тянуть
      1,6 МБ вместе с первым кадром и держит показ страницы. Подставляет их
      скрипт ниже – после того как страница отрисована. До этого момента
      виден постер, он же и остаётся, если человек ушёл раньше. */}
  {/* Первый кадр – картинкой, а не атрибутом poster у видео. Через poster
      браузер тянул файл для компьютера даже на телефоне: выбрать нужный из
      двух умеет только разметка, а подменял его скрипт, который теперь
      отложен. Здесь media выбирает файл до загрузки, и на телефоне едут
      23 КБ вместо 58 (найдено замером 07.11.2026). Это и есть главный кадр
      страницы, поэтому fetchpriority high. */}
  <picture class="hero__shot">
    <source media="(max-width: 620px)" srcset="/img/hero-poster-m.webp" type="image/webp" />
    <img class="hero__bg" src="/img/hero-poster.webp" alt="" aria-hidden="true" fetchpriority="high" decoding="async" width="1600" height="900" />
  </picture>
  <video class="hero__bg hero__bg--video" muted loop playsinline preload="none" aria-hidden="true" data-hero-video
         data-src="/video/hero.mp4" data-src-m="/video/hero-m.mp4" data-src-m-max="620"></video>
  <script is:inline>
    (function () {
      var v = document.querySelector('[data-hero-video]');
      if (!v) return;
      function start() {
        var max = Number(v.getAttribute('data-src-m-max') || 620);
        var small = window.matchMedia('(max-width: ' + max + 'px)').matches;
        var src = small ? v.getAttribute('data-src-m') : v.getAttribute('data-src');
        if (!src) return;
        v.src = src;
        v.load();
        // Кадр-картинку снимаем только когда видео реально пошло: иначе при
        // запрете автозапуска человек остался бы с пустым первым экраном.
        v.addEventListener('playing', function () { v.classList.add('is-on'); }, { once: true });
        var p = v.play();
        if (p && p.catch) p.catch(function () { /* автозапуск запрещён – остаётся постер */ });
      }
      // Запускаем тем же отложенным механизмом, что сторонние скрипты
      // (window.ecDelay в BaseLayout): по первому действию человека, при уходе
      // со страницы или через страховочные 7 секунд. Через idle не годится:
      // замер 07.11.2026 показал, что 1,6 МБ видео успевают загрузиться и
      // декодирование держит поток 410 мс – это была вся недостача до 100
      // баллов, остальные метрики уже на 97-100.
      //
      // Человек видит постер сразу, а видео получает через мгновение после
      // первого касания или прокрутки. Если ecDelay почему-то нет, не теряем
      // видео совсем, а идём прежним путём через idle.
      if (typeof window.ecDelay === 'function') window.ecDelay(start);
      else if (document.readyState === 'complete') setTimeout(start, 1200);
      else window.addEventListener('load', function () { setTimeout(start, 1200); }, { once: true });
    })();
  </script>
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1>{hero.title}</h1>
      <p class="hero__lead">{hero.lead}</p>
    </div>
    <a class="btn hero__cta" href="/#final" data-open="lead">{hero.cta}</a>
  </div>
</section>

<style>
  .hero__shot {
    display: contents;
  }
  /* Видео лежит поверх кадра и становится видимым, только когда пошло. */
  .hero__bg--video {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .hero__bg--video.is-on {
    opacity: 1;
  }
  .hero {
    position: relative;
    margin-top: calc(var(--header-h) * -1 - 1rem);
    min-height: 100svh;
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
  }
  .hero__bg {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    z-index: -2;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(0, 4, 12, .72) 0%, rgba(0, 4, 12, 0) 38%),
      linear-gradient(0deg, var(--c-bg) 2%, rgba(0, 4, 12, .1) 55%);
  }
  .hero__inner {
    display: grid;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 1rem + 5vw, 5rem);
  }
  .hero__copy { max-width: min(100%, 56rem); }
  .hero__lead {
    margin-top: 1rem;
    color: var(--c-text-2);
    font-size: 1.0625rem;
  }
  .hero__cta { justify-self: start; min-width: min(100%, 20rem); }

  /* Телефон: вертикальное видео во весь экран, машина сверху, текст и кнопка
     – на тёмной дороге внизу кадра */
  @media (max-width: 767px) {
    .hero__inner { gap: 1.5rem; padding-bottom: 2rem; }
    .hero__cta { justify-self: stretch; min-width: 0; }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 3rem;
    }
    .hero__lead { margin-top: 1.25rem; }
    .hero__cta { justify-self: end; min-width: 20rem; padding-block: 1.5rem; }
  }
</style>

<script>
  // кто просит меньше движения – останавливаем видео на первом кадре
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  } else if (video) {
    // На телефоне – вертикальное видео и его постер. Атрибут media у <source>
    // понимают не все браузеры (часть ставит десктопное 16:9), поэтому
    // выбираем источник сами.
    const mobile = video.querySelector<HTMLSourceElement>('source[media]');
    if (mobile && matchMedia(mobile.media).matches) {
      video.poster = video.dataset.posterM ?? video.poster;
      if (video.currentSrc !== mobile.src) { video.src = mobile.src; video.load(); }
    }
    // iPhone в режиме энергосбережения не запускает autoplay сам –
    // пробуем ещё раз при первом касании экрана
    const play = () => video.play().catch(() => {});
    play();
    addEventListener('touchstart', play, { once: true, passive: true });
  }
</script>
