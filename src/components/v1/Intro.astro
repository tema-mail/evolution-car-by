---
/**
 * Заставка при входе: логотип → «Подбираем и привозим…» → «Ваш автомобиль.
 * Наша ответственность.» по 1,5 с, затем занавес уходит вверх и открывает
 * сайт. Только при самом первом заходе с устройства (localStorage, правило
 * владельца 13.11.2026: не каждую сессию), пропускается нажатием или Esc,
 * при «меньше движения» в системе не показывается. Включается скриптом до
 * первой отрисовки – без него (или с ошибкой) сайт виден сразу.
 */
import { intro } from '../../content/home';

const words = intro.lead.split(' ').map((w) => ({ text: w.replace(/\*/g, ''), accent: false, raw: w }));
// акцент – фраза между звёздочками, может занимать несколько слов
let inAccent = false;
for (const w of words) {
  if (w.raw.startsWith('*')) inAccent = true;
  w.accent = inAccent;
  if (w.raw.endsWith('*')) inAccent = false;
}
---

<script is:inline>
  try {
    // localStorage, а не sessionStorage: заставка один раз на устройство,
    // повторный заход (новая вкладка, другой день) – сразу сайт.
    if (!localStorage.getItem('ev-intro-seen') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('ev-intro-on');
      localStorage.setItem('ev-intro-seen', '1');
    }
  } catch (e) {}
</script>

<div class="ev-intro" data-intro aria-hidden="true">
  <div class="ev-intro__glow"></div>

  <div class="ev-intro__stage ev-intro__stage--logo">
    <div class="ev-intro__logo">
      <img src="/img/logo-evolution-car.webp" alt="" width="939" height="48" />
      <span class="ev-intro__shine"></span>
    </div>
  </div>

  <p class="ev-intro__stage ev-intro__stage--lead">
    {words.map((w, i) => (
      <span class:list={['ev-intro__word', { 'is-accent': w.accent }]} style={`--i:${i}`}>{w.text}</span>
    ))}
  </p>

  <div class="ev-intro__stage ev-intro__stage--title">
    {intro.title.map((line, i) => <span class="ev-intro__line" style={`--i:${i}`}>{line}</span>)}
  </div>

  <span class="ev-intro__bar"></span>
  <button class="ev-intro__skip" type="button" data-intro-skip>{intro.skip}</button>
</div>

<style is:global>
  .ev-intro { display: none; }
  html.ev-intro-on { overflow: hidden; }
  html.ev-intro-on .ev-intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--c-bg);
    color: var(--c-text);
    overflow: hidden;
    transition: transform 1s cubic-bezier(.77, 0, .18, 1), border-radius 1s cubic-bezier(.77, 0, .18, 1);
  }
  /* выход: занавес уезжает вверх, нижний край скругляется */
  html.ev-intro-on .ev-intro.is-leaving { transform: translateY(-100%); border-radius: 0 0 50% 50% / 0 0 18vh 18vh; }
  html.ev-intro-on .ev-intro.is-leaving .ev-intro__stage--title { transform: translateY(18vh); opacity: 0; transition: transform 1s cubic-bezier(.77, 0, .18, 1), opacity .6s ease; }

  /* медленно плывущее оранжевое свечение на фоне */
  .ev-intro__glow {
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--c-accent) 28%, transparent) 0%, transparent 60%);
    filter: blur(20px);
    animation: ev-intro-glow 4.9s ease-in-out both;
  }
  @keyframes ev-intro-glow {
    0% { opacity: 0; scale: .6; translate: -70% -40%; }
    40% { opacity: .9; }
    100% { opacity: .55; scale: 1.15; translate: -30% -60%; }
  }

  .ev-intro__stage { position: absolute; inset: auto; padding-inline: var(--gutter); text-align: center; }

  /* 1. логотип: буквы проявляются слева направо, по ним пробегает блик */
  .ev-intro__stage--logo { animation: ev-intro-out .35s ease-in 1.2s both; }
  .ev-intro__logo { position: relative; width: min(80vw, 46rem); }
  .ev-intro__logo img {
    display: block;
    width: 100%;
    height: auto;
    clip-path: inset(0 100% 0 0);
    animation: ev-intro-wipe .9s cubic-bezier(.65, 0, .35, 1) .1s forwards;
  }
  .ev-intro__shine {
    position: absolute;
    inset: 0;
    -webkit-mask: url(/img/logo-evolution-car.webp) center / 100% 100% no-repeat;
    mask: url(/img/logo-evolution-car.webp) center / 100% 100% no-repeat;
    background: linear-gradient(100deg, transparent 35%, var(--c-accent) 47%, var(--c-text) 50%, var(--c-accent) 53%, transparent 65%) 150% 0 / 250% 100% no-repeat;
    animation: ev-intro-shine .8s ease-in-out .7s forwards;
  }
  @keyframes ev-intro-wipe { to { clip-path: inset(0 0 0 0); } }
  @keyframes ev-intro-shine { to { background-position: -150% 0; } }

  /* 2. фраза: слова выплывают по очереди из размытия */
  .ev-intro__stage--lead {
    max-width: 44rem;
    font-family: var(--font-display);
    font-weight: 560;
    font-size: clamp(1.375rem, 1rem + 1.8vw, 2.25rem);
    line-height: 1.25;
    letter-spacing: -.03em;
    animation: ev-intro-out .3s ease-in 3.05s both;
  }
  .ev-intro__word {
    display: inline-block;
    margin-inline: .14em;
    opacity: 0;
    filter: blur(10px);
    transform: translateY(.6em);
    animation: ev-intro-word .45s cubic-bezier(.2, .7, .2, 1) calc(1.45s + var(--i) * 22ms) forwards;
  }
  .ev-intro__word.is-accent { color: var(--c-accent); }
  @keyframes ev-intro-word { to { opacity: 1; filter: blur(0); transform: none; } }

  /* 3. «Ваш автомобиль. Наша ответственность.» – крупно, вторая строка серым */
  .ev-intro__stage--title { display: grid; gap: .1em; }
  .ev-intro__line {
    display: block;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(1.75rem, .6rem + 6vw, 6rem);
    white-space: nowrap;
    line-height: 1;
    letter-spacing: -.06em;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transform: translateY(.4em);
    animation: ev-intro-line .8s cubic-bezier(.2, .7, .2, 1) calc(3.35s + var(--i) * .25s) forwards;
  }
  .ev-intro__line + .ev-intro__line { color: var(--c-text-3); }
  @keyframes ev-intro-line { to { opacity: 1; clip-path: inset(0 0 -10% 0); transform: none; } }

  @keyframes ev-intro-out { to { opacity: 0; filter: blur(8px); transform: scale(1.04); visibility: hidden; } }

  /* полоска прогресса внизу */
  .ev-intro__bar {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--c-accent);
    transform-origin: left;
    transform: scaleX(0);
    animation: ev-intro-bar 4.8s linear forwards;
  }
  @keyframes ev-intro-bar { to { transform: scaleX(1); } }

  .ev-intro__skip {
    position: absolute;
    right: var(--gutter);
    bottom: 1.5rem;
    padding: .5rem 1rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--c-line-strong);
    color: var(--c-text-3);
    font-size: .8125rem;
    transition: color .2s, border-color .2s;
  }
  .ev-intro__skip:hover { color: var(--c-text); border-color: var(--c-accent); }

  /* после занавеса видео первого экрана мягко «наезжает» */
  html.ev-intro-reveal [data-hero-video] { animation: ev-intro-hero 1.6s cubic-bezier(.2, .7, .2, 1) both; }
  @keyframes ev-intro-hero { from { transform: scale(1.12); filter: brightness(.6); } to { transform: none; filter: none; } }
</style>

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-intro]');
  if (el && root.classList.contains('ev-intro-on')) {
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      root.classList.add('ev-intro-reveal');
      el.classList.add('is-leaving');
      const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
      if (video) {
        video.currentTime = 0;
        video.play().catch(() => {});
      }
      setTimeout(() => {
        root.classList.remove('ev-intro-on');
        el.remove();
      }, 1050);
    };
    const timer = setTimeout(finish, 4800);
    const skip = () => {
      clearTimeout(timer);
      finish();
    };
    el.addEventListener('click', skip);
    addEventListener('keydown', (e) => e.key === 'Escape' && skip());
  } else {
    el?.remove();
  }
</script>
