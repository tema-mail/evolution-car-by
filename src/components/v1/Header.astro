---
/**
 * Шапка по образцу evolutioncarservice.ru: без строки из восьми ссылок –
 * логотип, телефон, квадратные иконки звонка и Telegram, кнопка заявки и
 * «Меню», которое раскрывает MegaMenu. Все разделы – в нём.
 */
import { site } from '../../content/site';
import MegaMenu from './MegaMenu.astro';
---

<header class="hdr">
  <div class="container">
    <div class="hdr__bar">
      <a class="hdr__logo" href="/" aria-label={site.brand}>
        {/* длинный знак «EVOLUTION CAR» – с 768 px, на телефоне – короткий «EV» */}
        <picture>
          <source media="(min-width: 768px)" srcset="/img/logo-evolution-car.webp" width="939" height="48" />
          <img src="/img/logo-ev.png" alt="" width="197" height="57" />
        </picture>
      </a>

      <a class="hdr__phone" href={site.phoneHref}>
        <span class="hdr__phone-num">{site.phone}</span>
        <span class="hdr__phone-hours">{site.hoursFull}</span>
      </a>

      <div class="hdr__icons">
        <a class="hdr__icon" href={site.phoneHref} aria-label={`Позвонить: ${site.phone}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
        </a>
        <a class="hdr__icon" href={site.telegram} aria-label="Написать в Telegram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 18.7 19c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.3-.1-.5-.6-.2L6.3 12.7 1.5 11.2c-1-.3-1-1 .2-1.5l19-7.3c.9-.3 1.6.2 1.2 1.9Z"/></svg>
        </a>
      </div>

      <a class="hdr__cta" href="/#final" data-open="lead">Подобрать авто</a>

      <button class="hdr__menu" type="button" aria-controls="mega" aria-expanded="false" aria-label="Открыть меню" data-mega-toggle>
        <span class="hdr__menu-label">Меню</span>
        <span class="hdr__bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<MegaMenu />

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 60;
    padding-block: 1rem;
  }
  .hdr__bar {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .625rem .625rem .625rem 1.25rem;
    border-radius: var(--r-pill);
    background: rgba(16, 20, 28, .82);
    backdrop-filter: blur(14px);
    border: 1px solid var(--c-line);
  }
  .hdr__logo { flex: none; margin-right: auto; }
  .hdr__logo picture { display: block; }
  .hdr__logo img { height: 24px; width: auto; display: block; }

  .hdr__phone { display: none; line-height: 1.25; white-space: nowrap; margin-right: .75rem; }
  .hdr__phone-num { display: block; font-size: .9375rem; font-weight: 600; transition: color .2s var(--ease); }
  .hdr__phone-hours { display: block; font-size: .75rem; color: var(--c-text-3); }
  .hdr__phone:hover .hdr__phone-num { color: var(--c-accent); }

  .hdr__icons { display: flex; gap: .5rem; }
  .hdr__icon,
  .hdr__menu {
    display: grid;
    place-items: center;
    height: 44px;
    min-width: 44px;
    border-radius: 10px;
    border: 1px solid var(--c-line-strong);
    color: var(--c-text);
    transition: color .2s var(--ease), border-color .2s var(--ease), background .2s var(--ease);
  }
  .hdr__icon:hover, .hdr__icon:focus-visible { color: var(--c-accent); border-color: var(--c-accent); }

  .hdr__cta {
    display: none;
    align-items: center;
    height: 44px;
    padding-inline: 1.25rem;
    border-radius: 10px;
    background: var(--c-accent);
    color: var(--c-btn-text);
    font-size: .875rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background .2s var(--ease);
  }
  .hdr__cta:hover { background: var(--c-accent-hover); }

  .hdr__menu { display: flex; gap: .625rem; padding-inline: .75rem; }
  .hdr__menu-label { display: none; font-size: .875rem; font-weight: 600; }
  .hdr__menu:hover, .hdr__menu[aria-expanded='true'] { color: var(--c-accent); border-color: var(--c-accent); }
  .hdr__bars { display: grid; gap: 4px; width: 18px; }
  .hdr__bars i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform .25s var(--ease), opacity .25s var(--ease);
  }
  .hdr__menu[aria-expanded='true'] .hdr__bars i:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .hdr__menu[aria-expanded='true'] .hdr__bars i:nth-child(2) { opacity: 0; }
  .hdr__menu[aria-expanded='true'] .hdr__bars i:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  @media (min-width: 768px) {
    .hdr__logo img { height: 18px; }
    .hdr__cta { display: inline-flex; }
    .hdr__menu-label { display: inline; }
    .hdr__menu { padding-inline: 1rem; }
  }
  @media (min-width: 1024px) {
    .hdr__bar { padding-left: 1.75rem; gap: .625rem; }
    .hdr__phone { display: block; }
  }
</style>
