---
import Socials from '../shared/Socials.astro';
import { footer } from '../../content/home';
import { site } from '../../content/site';
import { popularBrands } from '../../content/brands';
---

<footer class="footer">
  <div class="container">
    <!-- Бренд с контактами и четыре колонки ссылок – одним рядом на десктопе -->
    <div class="footer__main">
      <div class="footer__brand">
        <a class="footer__logo" href="/">
          <img src="/img/logo-evolution-car.webp" alt={site.brand} width="939" height="48" />
        </a>
        <a class="footer__phone" href={site.phoneHref}>{site.phone}</a>
        <a class="footer__mail" href={site.emailHref}>{site.email}</a>
        <p class="footer__muted">{site.hoursShowroom}<br />{site.hoursService}</p>
        <p class="footer__muted">Шоурум и сервис: {site.address}</p>
        <ul class="footer__social">
          <Socials />
        </ul>
      </div>

      {footer.columns.map((column) => (
        <nav class="footer__col" aria-label={column.title}>
          <p class="footer__col-title">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <!-- 3. SEO-строки: марки и города одной строкой, а не длинными колонками -->
    <div class="footer__lines">
      <nav class="footer__line" aria-label="Популярные марки">
        <p class="footer__line-title">Популярные марки</p>
        <ul>
          {popularBrands().slice(0, 10).map((brand) => (
            <li><a href={`/catalog/${brand.slug}/`}>{brand.name}</a></li>
          ))}
        </ul>
      </nav>
      <nav class="footer__line" aria-label="Доставка по городам">
        <p class="footer__line-title">Доставка по городам</p>
        <ul>
          {footer.cities.map((city) => (
            <li><a href={city.href}>{city.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- 4. Юридическое -->
    <div class="footer__bottom">
      <p>© {new Date().getFullYear()} {site.brand} · {site.company}, УНП {site.unp}</p>
      <ul class="footer__legal">
        {footer.legal.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <a class="footer__credit" href={footer.creditHref} target="_blank" rel="noopener">{footer.credit}</a>
    </div>
  </div>

  <!-- Медленная бегущая строка: две одинаковые половины сдвигаются на -50%,
       поэтому шов не виден. -->
  <div class="footer__marquee" aria-hidden="true">
    <div class="footer__marquee-track">
      {[0, 1].map(() => (
        <div class="footer__marquee-half">
          {Array.from({ length: 4 }, () => <span class="footer__word">EVOLUTION CAR</span>)}
        </div>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(2.5rem, 1.5rem + 3vw, 3.5rem);
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, var(--c-bg) 0%, #1a0c05 100%);
  }
  .footer__main {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    padding-bottom: 2rem;
  }
  .footer__brand { grid-column: 1 / -1; display: grid; gap: .375rem; align-content: start; justify-items: start; }
  .footer__logo { margin-bottom: 1rem; }
  .footer__logo img { width: min(100%, 15rem); height: auto; display: block; }
  .footer__phone { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; line-height: 1.2; }
  .footer__phone:hover { color: var(--c-accent); }
  .footer__mail { color: var(--c-text-2); font-size: .875rem; }
  .footer__mail:hover { color: var(--c-accent); }
  .footer__muted { color: var(--c-text-3); font-size: .8125rem; line-height: 1.5; }
  .footer__social { display: flex; flex-wrap: wrap; gap: .375rem; margin-top: .75rem; }
  .footer__social :global(a) {
    width: 2.25rem; height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--c-line-strong);
    display: grid; place-items: center;
    color: var(--c-text-2);
    transition: color .2s var(--ease), border-color .2s var(--ease);
  }
  .footer__social :global(svg) { width: 16px; height: 16px; }
  .footer__social :global(a:hover) { color: var(--c-accent); border-color: var(--c-accent); }

  .footer__col-title, .footer__line-title {
    margin-bottom: .875rem;
    color: var(--c-text-3);
    font-size: .6875rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .footer__col li + li { margin-top: .5rem; }
  .footer__col a, .footer__line a, .footer__legal a { color: var(--c-text-2); font-size: .8125rem; transition: color .2s var(--ease); }
  .footer__col a:hover, .footer__line a:hover, .footer__legal a:hover { color: var(--c-accent); }

  .footer__lines { display: grid; gap: 1rem; padding-block: 1.25rem; border-top: 1px solid var(--c-line); }
  .footer__line { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1rem; }
  .footer__line-title { margin-bottom: 0; }
  .footer__line ul { display: flex; flex-wrap: wrap; gap: .375rem 1rem; }

  .footer__bottom {
    display: grid;
    gap: .75rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--c-line);
    color: var(--c-text-3);
    font-size: .75rem;
  }
  .footer__legal { display: flex; flex-wrap: wrap; gap: .375rem 1.25rem; }
  .footer__legal a { font-size: .75rem; color: var(--c-text-3); }
  .footer__credit { transition: color .2s var(--ease); }
  .footer__credit:hover { color: var(--c-accent); }

  .footer__marquee { overflow: hidden; margin-top: .5rem; user-select: none; pointer-events: none; }
  .footer__marquee-track { display: flex; width: max-content; animation: footer-marquee 90s linear infinite; }
  .footer__marquee-half { display: flex; flex: none; }
  .footer__word {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, -1rem + 12vw, 9rem);
    line-height: .85;
    letter-spacing: -.02em;
    color: rgba(255, 255, 255, .06);
    white-space: nowrap;
    padding-right: .5em;
  }
  @keyframes footer-marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .footer__marquee-track { animation: none; } }

  @media (min-width: 768px) {
    .footer__main { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .footer__bottom { grid-template-columns: auto 1fr auto; align-items: center; gap: 2rem; }
    .footer__legal { justify-content: center; }
  }
  @media (min-width: 1100px) {
    .footer__main { grid-template-columns: minmax(0, 1.3fr) repeat(4, minmax(0, 1fr)); gap: 2.5rem; }
    .footer__brand { grid-column: auto; }
    .footer__lines { grid-template-columns: auto auto; justify-content: space-between; gap: 2.5rem; }
  }
</style>
