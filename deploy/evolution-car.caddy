# >>> evolution-car: автосалон Evolution Car (Минск) – блок добавляет deploy/install.sh
# Проверочный адрес. Сертификат настоящий, чтобы владелец открывал стенд
# без предупреждений браузера; от поисковиков закрыт заголовком и robots.txt.
evolution-car.45.12.72.227.nip.io {
	encode gzip zstd
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	reverse_proxy evolution-car-web:8080
}
# Боевой домен включается ОТДЕЛЬНО, в момент переключения DNS на hoster.by:
# пока A-запись evolutioncar.by смотрит не на нас, Caddy не сможет выпустить
# для него сертификат и будет впустую долбиться в Let's Encrypt.
# Тогда же снять Disallow в robots.txt.ts и noindex в BaseLayout.
