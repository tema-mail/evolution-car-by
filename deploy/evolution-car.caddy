# >>> evolution-car: автосалон Evolution Car (Минск) – блок добавляет deploy/install.sh
# Боевой домен. Сертификат Caddy выпустит сам, как только A-запись
# evolutioncar.by будет смотреть на этот сервер.
evolutioncar.by {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Заявки с форм и отчёты кабинета – отдельный сервис; всё остальное статика.
	handle /api/* {
		reverse_proxy evolution-car-api:8090
	}
	handle {
		reverse_proxy evolution-car-web:8080
	}
}
www.evolutioncar.by {
	redir https://evolutioncar.by{uri} permanent
}
# Проверочный адрес остаётся рабочим и после переключения домена: удобно
# смотреть изменения до того, как их увидят посетители. От поисковиков
# закрыт заголовком, чтобы не плодить дубли боевых страниц.
evolution-car.45.12.72.227.nip.io {
	encode gzip zstd
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	# Заявки с форм и отчёты кабинета – отдельный сервис; всё остальное статика.
	handle /api/* {
		reverse_proxy evolution-car-api:8090
	}
	handle {
		reverse_proxy evolution-car-web:8080
	}
}
# Кабинет живёт на своём поддомене (правило владельца 28.10.2026:
# «во всех абсолютно админках делать admin.<домен>, так логичнее»).
# Файлы лежат в /admin/ той же выкладки – подставляем префикс здесь,
# чтобы кабинет не зависел от того, где он собран.
admin.evolutioncar.by {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	handle /api/* {
		reverse_proxy evolution-car-api:8090
	}
	# Общие файлы сборки лежат в корне выкладки, а не внутри /admin:
	# стили, скрипты островов, картинки и шрифты отдаём как есть,
	# иначе префикс уводит их в 404 и кабинет остаётся без вёрстки.
	handle /_astro/* {
		reverse_proxy evolution-car-web:8080
	}
	handle /img/* {
		reverse_proxy evolution-car-web:8080
	}
	handle /favicon* {
		reverse_proxy evolution-car-web:8080
	}
	handle /apple-touch-icon* {
		reverse_proxy evolution-car-web:8080
	}
	handle {
		rewrite * /admin{uri}
		reverse_proxy evolution-car-web:8080
	}
}
# <<< evolution-car
